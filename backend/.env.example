APP_NAME="E-Trike Operations"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8017
FRONTEND_URL=http://localhost:5183
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=etrike_tracking
DB_USERNAME=etrike_app
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=etrike_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
SANCTUM_STATEFUL_DOMAINS=localhost:5183,127.0.0.1:5183
DEMO_ADMIN_PASSWORD=

# Match the frontend API proxy when running php artisan serve.
SERVER_PORT=8017
